---
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<div class="container">
		<header class="header">
			<h1 class="header__title">OneVote</h1>
			<div class="header__divider"></div>
			<nav class="navigation">
				<a href="#" class="navigation__item">elections</a>
				<a href="#" class="navigation__item">states</a>
				<a href="#" class="navigation__item">algorithms</a>
				<a href="#" class="navigation__item">essays</a>
				<a href="#" class="navigation__item">about</a>
			</nav>
		</header>

		<main class="main-content">
			<div class="main-content__question">
				how much will your vote be worth in the
				<span class="select-wrapper">
					<select>
						<option value="2028">2028</option>
						<option value="2024">2024</option>
						<option value="2020">2020</option>
					</select>
				</span>
				<span class="select-wrapper">
					<select>
						<option value="presidential">presidential</option>
						<option value="senate">senate</option>
						<option value="house">house</option>
					</select>
				</span>
				election?
			</div>

			<div class="comparison-container">
				<div
					class="comparison-container__side comparison-container__side--left"
				>
					<h3>you are a...</h3>
					<div class="form-group">
						<label for="left-party">party</label>
						<select id="left-party">
							<option value="">select party</option>
							<option value="democrat">Democrat</option>
							<option value="republican">Republican</option>
							<option value="independent">Independent</option>
						</select>
					</div>
					<div class="form-group">
						<label for="left-state">state</label>
						<select id="left-state">
							<option value="">select state</option>
							<option value="AL">Alabama</option>
							<option value="AK">Alaska</option>
							<option value="AZ">Arizona</option>
							<option value="CA">California</option>
							<option value="NY">New York</option>
							<option value="TX">Texas</option>
							<option value="WY">Wyoming</option>
						</select>
					</div>

					<div class="form-group">
						<label for="left-city">city (optional)</label>
						<input type="text" id="left-city" placeholder="Enter city" />
					</div>
				</div>

				<div class="comparison-container__divider">
					<button class="comparison-container__button">Go</button>
				</div>

				<div
					class="comparison-container__side comparison-container__side--right"
				>
					<h3>(optional) compare to a...</h3>
					<div class="form-group">
						<label for="right-party">party</label>
						<select id="right-party">
							<option value="">select party</option>
							<option value="democrat">Democrat</option>
							<option value="republican">Republican</option>
							<option value="independent">Independent</option>
						</select>
					</div>
					<div class="form-group">
						<label for="right-state">state</label>
						<select id="right-state">
							<option value="">select state</option>
							<option value="AL">Alabama</option>
							<option value="AK">Alaska</option>
							<option value="AZ">Arizona</option>
							<option value="CA">California</option>
							<option value="NY">New York</option>
							<option value="TX">Texas</option>
							<option value="WY">Wyoming</option>
						</select>
					</div>
					<div class="form-group">
						<label for="right-city">city (optional)</label>
						<input type="text" id="right-city" placeholder="Enter city" />
					</div>
				</div>
			</div>
		</main>

		<footer class="footer">
			<div class="footer__divider"></div>
		</footer>
	</div>
</Layout>

<style lang="scss">
	@use "../styles/global.scss";
	@use "../styles/index.scss";
</style>
