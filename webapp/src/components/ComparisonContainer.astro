---
import { getCollection } from 'astro:content';

const states = await getCollection('states');
---

<div class="comparison-container">
	<div class="comparison-container__side comparison-container__side--left">
		<h3>you live in...</h3>
		<div class="form-group">
			<label for="left-state">state</label>
			<select id="left-state">
				<option value="">select state</option>
				{states.map((state) => (
					<option value={state.data.abbreviation}>{state.data.name}</option>
				))}
			</select>
		</div>
