---
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  url: string;
  slug: string;
}
const props = Astro.props;
const title = props.frontmatter.title;
---

<Layout title={title}>
  <hr />

  <slot />
  <!-- your content is injected here -->
</Layout>
