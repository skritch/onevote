---
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
  url: string;
  slug: string;
}
const props = Astro.props;
const title = props.frontmatter.title;
---

<Layout title={title}>
  <div class="notebook-wrapper">
    <slot />
  </div>
</Layout>

<style is:global>
  body:has(.notebook-wrapper) .main-content {
    max-width: 968px;
    padding: 0;
    height: calc(100dvh - 50px);
    overflow: hidden;
  }

  .notebook-wrapper {
    height: 100%;
  }
</style>
