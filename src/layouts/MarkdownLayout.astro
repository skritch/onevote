---
import type { MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";
import { parseLocalDate } from "../utils/date.ts";

// https://docs.astro.build/en/basics/layouts/#markdown-layout-props
type Props = MarkdownLayoutProps<{
  // Define frontmatter props here
  title: string;
  date?: string;
  math?: boolean;
}>;

const { frontmatter } = Astro.props;
const date = frontmatter.date
  ? parseLocalDate(frontmatter.date).toLocaleDateString()
  : undefined;
---

<Layout
  title={frontmatter.title}
  ,
  url={frontmatter.url}
  math={frontmatter.math}
>
  <header class="post-header">
    <h1 class="post-title" itemprop="name headline">{frontmatter.title}</h1>
    {
      date && (
        <p class="post-meta" itemprop="datePublished">
          {date}
        </p>
      )
    }
    <hr />
  </header>

  <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
    <div class="post-content" itemprop="articleBody">
      <slot />
      <!-- your content is injected here -->
    </div>
  </article>
</Layout>
