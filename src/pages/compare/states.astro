---
import { readFileSync } from "fs";
import { join } from "path";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CompareStatesPage from "../../components/compare/CompareStatesPage.svelte";
import type { DistrictData, DistrictIndex } from "../../lib/districts";
import { buildDistrictIndex } from "../../lib/districts";

const elections = await getCollection("elections");
const states = await getCollection("states");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
	(a, b) => b - a,
);
const stateList = states.map((s) => s.data);

const districtIndex: Record<string, DistrictIndex> = {};
for (const state of states) {
	try {
		const raw: DistrictData = JSON.parse(
			readFileSync(
				join(process.cwd(), ".data/district_paths", `${state.data.statePO}.json`),
				"utf-8",
			),
		);
		districtIndex[state.data.statePO] = buildDistrictIndex(raw);
	} catch {
		// No district data for this state (e.g. DC).
	}
}
---

<Layout>
	<CompareStatesPage client:load {years} states={stateList} {districtIndex} />
</Layout>
