---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CompareResultForm from "../../components/CompareResultForm.svelte";
import { officesByName } from "../../lib/elections";

const elections = await getCollection("elections");
const states = await getCollection("states");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
	(a, b) => b - a,
);
const offices = Object.keys(officesByName);
const stateList = states.map((s) => ({ id: s.id, name: s.data.name }));
---

<Layout>
	<CompareResultForm client:load {years} {offices} states={stateList} />
</Layout>
