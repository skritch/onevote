---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CompareStatesPage from "../../components/compare/CompareStatesPage.svelte";
import type { DistrictIndex } from "../../lib/districts";
import districtIndexRaw from "../../data/district_index.json";

const elections = await getCollection("elections");
const states = await getCollection("states");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
	(a, b) => b - a,
);
const stateList = states.map((s) => s.data);
const districtIndex = districtIndexRaw as Record<string, DistrictIndex>;
---

<Layout>
	<CompareStatesPage client:only="svelte" {years} states={stateList} {districtIndex} />
</Layout>
