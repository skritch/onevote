---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const elections = await getCollection('elections');
  return elections.map(election => ({
    params: { id: election.id },
    props: { election },
  }));
}

const { election } = Astro.props;
---

<Layout>
  <div class="election-page">
    <h1>{election.data.name}</h1>

    <div class="election-page__metadata">
      <span class="election-page__year">{election.data.year}</span>
      <span class="election-page__type">{election.data.type}</span>
    </div>

    <div class="election-page__content">
      <p>Election information and analysis will go here.</p>
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "../../styles/variables.scss";
  @use "../../styles/global.scss";

  .election-page {
    max-width: 800px;
    margin: 0 auto;
    padding: variables.$spacing-lg;

    h1 {
      font-size: variables.$font-size-large;
      font-variant: small-caps;
      color: variables.$dark-gray;
      margin-bottom: variables.$spacing-sm;
    }

    &__metadata {
      display: flex;
      gap: variables.$spacing-md;
      margin-bottom: variables.$spacing-lg;
      font-size: variables.$font-size-base;
      color: variables.$medium-gray;
    }

    &__year {
      font-weight: 600;
    }

    &__type {
      text-transform: capitalize;
    }

    &__content {
      background-color: variables.$white;
      padding: variables.$spacing-lg;
      border-radius: variables.$border-radius;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
  }
</style>
