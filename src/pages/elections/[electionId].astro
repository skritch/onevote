---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ElectionPage from "../../components/election/ElectionPage.svelte";

export async function getStaticPaths() {
  const elections = await getCollection("elections");
  return elections.map((election) => ({
    params: { electionId: election.id },
    props: { election },
  }));
}

const { election } = Astro.props;
---

<Layout>
  <script is:inline>
    document.documentElement.setAttribute("data-election-loading", "");
  </script>
  <ElectionPage
    client:load
    year={election.data.year}
    electionName={election.data.name}
  />
</Layout>
