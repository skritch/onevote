---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatePage from "../../components/state/StatePage.svelte";
import type { State } from "../../lib/states";
import { getDistrictResultsByYear, type DistrictResult } from "../../lib/districts";
import { urlsByYear } from "../../lib/maps";
import type { Year } from "../../lib/manifest";

export async function getStaticPaths() {
  const states = await getCollection("states");
  return states.map((state) => {
    return {
      params: { stateId: state.id },
      props: { 
        state: state.data, 
      },
    }});
}

const {
  state
}: { 
  state: State,
} = Astro.props;
const elections = await getCollection("elections");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
  (a, b) => b - a,
);
---

<Layout>
  <script is:inline>
    document.documentElement.setAttribute("data-state-loading", "");
  </script>
  <StatePage
    client:load
    {years}
    stateName={state.stateName}
    statePO={state.statePO}
  />
</Layout>
