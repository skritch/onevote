---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatePage from "../../components/state/StatePage.svelte";
import type { State } from "../../lib/states";
import type { DistrictIndex } from "../../lib/districts";
import districtIndexRaw from "../../data/district_index.json";

export async function getStaticPaths() {
  const states = await getCollection("states");
  const di = districtIndexRaw as Record<string, DistrictIndex>;
  return states.map((state) => ({
    params: { stateId: state.id },
    props: { state: state.data, districtIndex: di[state.data.statePO] ?? null },
  }));
}

const {
  state,
  districtIndex,
}: { state: State; districtIndex: DistrictIndex | null } = Astro.props;
const elections = await getCollection("elections");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
  (a, b) => b - a,
);
---

<Layout>
  <script is:inline>
    document.documentElement.setAttribute("data-state-loading", "");
  </script>
  <StatePage
    client:load
    {years}
    stateName={state.stateName}
    statePO={state.statePO}
    {districtIndex}
  />
</Layout>
