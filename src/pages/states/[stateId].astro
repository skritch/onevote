---
import { readFileSync } from "fs";
import { join } from "path";
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StatePage from "../../components/state/StatePage.svelte";
import type { State } from "../../lib/states";
import type { DistrictData } from "../../lib/districts";

export async function getStaticPaths() {
  const states = await getCollection("states");
  return states.map((state) => {
    let districtData: DistrictData | null = null;
    try {
      districtData = JSON.parse(
        readFileSync(
          join(
            process.cwd(),
            ".data/district_paths",
            `${state.data.statePO}.json`,
          ),
          "utf-8",
        ),
      );
    } catch {
      // No district data for this state (e.g. DC).
    }
    return {
      params: { stateId: state.id },
      props: { state: state.data, districtData },
    };
  });
}

const {
  state,
  districtData,
}: { state: State; districtData: DistrictData | null } = Astro.props;
const elections = await getCollection("elections");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
  (a, b) => b - a,
);
---

<Layout>
  <script is:inline>
    document.documentElement.setAttribute("data-state-loading", "");
  </script>
  <StatePage
    client:load
    {years}
    stateName={state.stateName}
    statePO={state.statePO}
    {districtData}
  />
</Layout>
