---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StateControls from "../../components/state/StateControls.svelte";
import ElectionSection from "../../components/ElectionSection.svelte";
import SettingsPanel from "../../components/SettingsPanel.svelte";
import StateValueCard from "../../components/state/StateValueCard.svelte";
import StateFactBox from "../../components/state/StateFactBox.svelte";
import { officesByName } from "../../lib/elections";

export async function getStaticPaths() {
  const states = await getCollection("states");
  return states.map((state) => ({
    params: { stateId: state.id },
    props: { state },
  }));
}

const { state } = Astro.props;
const elections = await getCollection("elections");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
  (a, b) => b - a,
);
const offices = Object.keys(officesByName);
---

<Layout>
  <script is:inline>
    // Hide URL-param-sensitive sections until Svelte hydrates with correct values.
    // StateControls removes this attribute after its first effect runs.
    document.documentElement.setAttribute('data-state-loading', '');
  </script>
  <div class="content-page state-page">
    <div class="page-header">
      <h1>{state.data.name}</h1>
      <div class="page-controls">
        <StateControls client:load {years} {offices} />
        <SettingsPanel client:load />
      </div>
    </div>

    <div class="state-page__panels">
      <StateValueCard client:load stateName={state.data.name} statePo={state.id} />
      <StateFactBox client:load statePo={state.id} />
    </div>

    <div class="state-page__content">
      <ElectionSection client:load focusState={state.id} />
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "../../styles/variables.scss";

  // Give the header its bottom spacing (global .page-header omits margin-bottom).
  .page-header {
    margin-bottom: variables.$spacing-lg;
  }

  .state-page {
    h1 {
      font-size: variables.$font-size-large;
      color: variables.$dark-gray;
      margin: 0;
      white-space: nowrap;
    }

    &__panels {
      display: grid;
      grid-template-columns: 55fr 45fr;
      gap: variables.$spacing-md;
      margin-bottom: variables.$spacing-md;
    }

    &__content {
      background-color: variables.$white;
      padding: variables.$spacing-md;
      border-radius: variables.$border-radius;
      border: 1px solid #e5e7eb;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07);
    }
  }

  @media (max-width: variables.$content-breakpoint) {
    .state-page__panels {
      grid-template-columns: 1fr;
    }
  }

  :global([data-state-loading]) {
    .page-controls,
    .state-page__panels,
    .state-page__content {
      opacity: 0;
    }
  }
</style>
