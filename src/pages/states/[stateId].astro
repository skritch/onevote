---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import StateControls from "../../components/StateControls.svelte";
import StateSection from "../../components/StateSection.svelte";
import SettingsPanel from "../../components/SettingsPanel.svelte";
import { officesByName } from "../../utils/elections";

export async function getStaticPaths() {
  const states = await getCollection("states");
  return states.map((state) => ({
    params: { stateId: state.id },
    props: { state },
  }));
}

const { state } = Astro.props;
const elections = await getCollection("elections");
const years = [...new Set(elections.map((e) => e.data.year))].sort(
  (a, b) => b - a,
);
const offices = Object.keys(officesByName);
---

<Layout>
  <div class="state-page">
    <div class="state-page__header">
      <h1>{state.data.name}</h1>
      <div class="state-page__header-controls">
        <StateControls client:load {years} {offices} />
        <SettingsPanel client:load />
      </div>
    </div>

    <div class="state-page__content">
      <StateSection client:load focusState={state.id} />
    </div>
  </div>
</Layout>

<style lang="scss">
  @use "../../styles/variables.scss";

  // 788px content + 2×16px Layout padding = 820px breakpoint.
  // The breakpoint fires exactly when wide-mode outer margins hit zero,
  // so there is no content-width jump at the transition.
  $wide-content-width: 788px;
  $breakpoint: 820px;

  .state-page {
    max-width: $wide-content-width;
    margin: 0 auto;

    &__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: variables.$spacing-lg;
      gap: variables.$spacing-md;

      h1 {
        font-size: variables.$font-size-large;
        color: variables.$dark-gray;
        margin: 0;
        white-space: nowrap;
      }
    }

    &__header-controls {
      display: flex;
      align-items: center;
      gap: variables.$spacing-xs;
      flex-shrink: 0;
    }

    &__content {
      background-color: variables.$white;
      padding: variables.$spacing-md;
      border-radius: variables.$border-radius;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    }
  }

  @media (max-width: $breakpoint) {
    .state-page {
      max-width: none;

      &__header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  }
</style>
