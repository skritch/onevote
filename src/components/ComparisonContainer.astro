---
import { getCollection } from "astro:content";

const states = await getCollection("states");
---

<div class="comparison-container">
	<div class="comparison-container__side comparison-container__side--left">
		<h3>You live in...</h3>
		<div class="form-group">
			<select id="left-state">
				<option value="">--select state--</option>
				{
					states.map((state) => (
						<option value={state.id}>{state.data.name}</option>
					))
				}
			</select>
		</div>
		<!-- <div class="form-group">
			<label for="left-party">party</label>
			<select id="left-party">
				<option value="">select party</option>
				<option value="democrat">Democrat</option>
				<option value="republican">Republican</option>
				<option value="independent">Independent</option>
			</select>
		</div>

		<div class="form-group">
			<label for="left-city">city (optional)</label>
			<input type="text" id="left-city" placeholder="Enter city" />
		</div> -->

		<button class="comparison-container__button">Go</button>
	</div>

	<!-- Right side panel hidden for now - will be used for comparison functionality later -->
	<!-- <div class="comparison-container__divider"></div>

	<div class="comparison-container__side comparison-container__side--right">
		<h3>(optional) compare to...</h3>
		<div class="form-group">
			<select id="right-state">
				<option value="">select state</option>
