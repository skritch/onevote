---
import { getCollection } from "astro:content";

const states = await getCollection("states");
const elections = await getCollection("elections");

const essays: { url: string; frontmatter: { title: string } }[] = Object.values(
	import.meta.glob("../pages/about/analysis/*.py", {
		eager: true,
		query: { pythonMetaOnly: true },
	}),
);
---

<header class="header">
	<div class="header__inner">
		<a href={import.meta.env.BASE_URL} class="header__title-link">
			<h1 class="header__title">OneVote</h1>
		</a>
		<nav class="navigation">
			<div class="navigation__item navigation__item--dropdown">
				<a href={`${import.meta.env.BASE_URL}compare/`} class="navigation__link"
					>compare</a
				>
				<div class="dropdown">
					<div class="dropdown__list">
						<a
							href={`${import.meta.env.BASE_URL}compare/states/`}
							class="dropdown__item">states</a
						>
						<a
							href={`${import.meta.env.BASE_URL}compare/elections/`}
							class="dropdown__item">elections</a
						>
						<span class="dropdown__item dropdown__item--disabled"
							>districts</span
						>
						<a
							href={`${import.meta.env.BASE_URL}compare/scenarios/`}
							class="dropdown__item">scenarios</a
						>
					</div>
				</div>
			</div>
			<div class="navigation__item navigation__item--dropdown">
				<a
					href={`${import.meta.env.BASE_URL}elections/`}
					class="navigation__link">elections</a
				>
				<div class="dropdown">
					<div class="dropdown__list">
						{
							elections.map((election) => (
								<a
									href={`${import.meta.env.BASE_URL}elections/${election.id}/`}
									class="dropdown__item"
								>
									{election.data.name}
								</a>
							))
						}
					</div>
				</div>
			</div>
			<div class="navigation__item navigation__item--dropdown">
				<a href={`${import.meta.env.BASE_URL}states/`} class="navigation__link"
					>states</a
				>
				<div class="dropdown">
					<div class="dropdown__grid">
						{
							states.map((state) => (
								<a
									href={`${import.meta.env.BASE_URL}states/${state.id.toLowerCase()}/`}
									class="dropdown__item"
								>
									{state.data.name}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</nav>
		<nav class="navigation navigation--right">
			<div class="navigation__item navigation__item--dropdown">
				<a href={`${import.meta.env.BASE_URL}about/`} class="navigation__link"
					>about</a
				>
				<div class="dropdown dropdown--left">
					<div class="dropdown__list">
						{
							essays.map((essay) => (
								<a href={essay.url} class="dropdown__item">
									{essay.frontmatter.title}
								</a>
							))
						}
					</div>
				</div>
			</div>
		</nav>
	</div>
</header>

<style lang="scss">
	@use "../styles/variables.scss";

	.header {
		width: 100%;
		border-bottom: 1px solid #e5e7eb;

		&__inner {
			display: flex;
			align-items: center;
			max-width: 1060px;
			margin: 0 auto;
			padding: variables.$spacing-xs variables.$spacing-md;
			gap: variables.$spacing-md;
		}

		&__title-link {
			text-decoration: none;
			color: inherit;
			flex-shrink: 0;
		}

		&__title {
			font-size: 1.4rem;
			font-weight: 700;
			color: variables.$dark-gray;
			margin: 0;
		}
	}

	.navigation {
		display: flex;
		align-items: center;
		gap: variables.$spacing-sm;

		&--right {
			margin-left: auto;
		}

		&__item {
			color: variables.$medium-gray;
			text-decoration: none;
			font-size: variables.$font-size-base;
			text-transform: capitalize;
			padding: 0 variables.$spacing-xs;
			border-radius: 4px;
			transition: color variables.$transition-duration ease;
			position: relative;
			white-space: nowrap;

			&:hover {
				color: variables.$dark-gray;
			}

			&--dropdown {
				position: relative;

				&:hover .dropdown {
					display: block;
				}
			}
		}

		&__link {
			color: inherit;
			text-decoration: none;
		}
	}

	.dropdown {
		display: none;
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		padding-top: variables.$spacing-xs;
		z-index: 1000;

		&--left {
			left: auto;
			right: 0;
			transform: none;
		}

		&__list {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
			background: white;
			border: 1px solid #e5e7eb;
			border-radius: variables.$border-radius;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			padding: variables.$spacing-xs;
			min-width: 200px;
		}

		&__grid {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0.15rem variables.$spacing-sm;
			background: white;
			border: 1px solid #e5e7eb;
			border-radius: variables.$border-radius;
			box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
			padding: variables.$spacing-xs;
		}

		&__item {
			color: variables.$medium-gray;
			text-decoration: none;
			font-size: variables.$font-size-small;
			padding: 1px variables.$spacing-xs;
			border-radius: variables.$border-radius;
			transition: all variables.$transition-duration ease;
			white-space: nowrap;

			&:hover {
				color: variables.$dark-gray;
				background-color: #f9fafb;
			}

			&--disabled {
				opacity: 0.4;
				cursor: default;

				&:hover {
					color: variables.$medium-gray;
					background-color: transparent;
				}
			}
		}
	}
</style>
